# إعدادات Supabase — انسخ هذا الملف إلى .env.local واملأ القيم من مشروعك.
# القيم تؤخذ من: Supabase → Project Settings → API
# (المفتاح anon عام بطبيعته، لكن لا نثبّته في الكود لسهولة التبديل والتدوير.)

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
